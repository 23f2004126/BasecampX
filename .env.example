# Copy to .env and fill in what you need. Every value is optional:
# without a .env the app uses the local defaults shown here.

# Security (change these outside local development)
SECRET_KEY=dev-secret-key-change-me
SECURITY_PASSWORD_SALT=dev-password-salt-change-me

# First admin account (used by create_initial_data.py)
ADMIN_EMAIL=admin@tma.com
ADMIN_PASSWORD=admin123

# Mail: MailHog locally. For real SMTP, e.g. Gmail:
#   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=true
#   MAIL_USERNAME=you@gmail.com MAIL_PASSWORD=<app password>
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=TMA <noreply@tma.local>

# Redis
CACHE_REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google Chat incoming webhook for daily reminders (leave empty to skip)
GCHAT_WEBHOOK_URL=

# Base URL used for links in emails
APP_BASE_URL=http://127.0.0.1:5001

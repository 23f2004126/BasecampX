# Copy to .env and replace the placeholders. .env is never committed.

# Security. Generate each value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
SECURITY_PASSWORD_SALT=replace-with-another-long-random-string

# First admin account (used by create_initial_data.py)
ADMIN_EMAIL=admin@tma.com
ADMIN_PASSWORD=choose-an-admin-password

# Mail: MailHog locally. For real SMTP, e.g. Gmail:
#   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=true
#   MAIL_USERNAME=you@gmail.com MAIL_PASSWORD=<app password>
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=TMA <noreply@tma.local>

# Redis
CACHE_REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google Chat incoming webhook for daily reminders (leave empty to skip)
GCHAT_WEBHOOK_URL=

# Base URL used for links in emails
APP_BASE_URL=http://127.0.0.1:5001

# Simulated payment gateway "processing" time, in seconds
PAYMENT_SIMULATION_SECONDS=1.0

digraph TMA {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.6, newrank=true, bgcolor="white", pad=0.4,
         label=<<B>Trekking Management Application — ER Diagram</B><BR/><FONT POINT-SIZE="10">PK = primary key · FK = foreign key · UQ = unique · crow's-foot notation</FONT>>,
         labelloc=t, fontname="Helvetica", fontsize=18];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#555555", dir=both];

  role [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#7c3aed">
   <TR><TD BGCOLOR="#7c3aed" COLSPAN="3"><FONT COLOR="white"><B>role</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
  </TABLE>>];

  user [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1d4ed8">
   <TR><TD BGCOLOR="#1d4ed8" COLSPAN="3"><FONT COLOR="white"><B>user</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">fs_uniquifier</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">contact_number</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_blacklisted</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  notification [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
   <TR><TD BGCOLOR="#475569" COLSPAN="3"><FONT COLOR="white"><B>notification</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">link</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_read</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  roles_users [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#7c3aed">
   <TR><TD BGCOLOR="#7c3aed" COLSPAN="3"><FONT COLOR="white"><B>roles_users</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B>, FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B>, FK</TD><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
  </TABLE>>];

  staff_profile [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1d4ed8">
   <TR><TD BGCOLOR="#1d4ed8" COLSPAN="3"><FONT COLOR="white"><B>staff_profile</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK, UQ</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">experience_years</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">specialization</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  trek [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#047857">
   <TR><TD BGCOLOR="#047857" COLSPAN="3"><FONT COLOR="white"><B>trek</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">difficulty</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">duration_days</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">total_slots</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">available_slots</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">end_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">instructions</TD><TD ALIGN="LEFT">TEXT</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">image_url</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">staff_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  booking [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b45309">
   <TR><TD BGCOLOR="#b45309" COLSPAN="3"><FONT COLOR="white"><B>booking</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">trek_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">booking_date</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">payment_status</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cancelled_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">certificate_no</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
  </TABLE>>];

  checklist_item [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#4d7c0f">
   <TR><TD BGCOLOR="#4d7c0f" COLSPAN="3"><FONT COLOR="white"><B>checklist_item</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">difficulty</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">trek_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">item</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_essential</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
  </TABLE>>];

  waitlist [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0e7490">
   <TR><TD BGCOLOR="#0e7490" COLSPAN="3"><FONT COLOR="white"><B>waitlist</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">trek_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  payment [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b45309">
   <TR><TD BGCOLOR="#b45309" COLSPAN="3"><FONT COLOR="white"><B>payment</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">booking_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">method</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">transaction_ref</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  review [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#be123c">
   <TR><TD BGCOLOR="#be123c" COLSPAN="3"><FONT COLOR="white"><B>review</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">trek_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">FK, UQ</TD><TD ALIGN="LEFT">booking_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_hidden</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
   <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  user -> notification [arrowhead=crowodot, arrowtail=teetee, label=" user_id "];
  user -> roles_users [arrowhead=crowodot, arrowtail=teetee, label=" user_id "];
  role -> roles_users [arrowhead=crowodot, arrowtail=teetee, label=" role_id "];
  user -> staff_profile [arrowhead=teeodot, arrowtail=teetee, label=" user_id "];
  user -> trek [arrowhead=crowodot, arrowtail=teeodot, label=" staff_id "];
  user -> booking [arrowhead=crowodot, arrowtail=teetee, label=" user_id "];
  trek -> booking [arrowhead=crowodot, arrowtail=teetee, label=" trek_id "];
  trek -> checklist_item [arrowhead=crowodot, arrowtail=teeodot, label=" trek_id "];
  user -> waitlist [arrowhead=crowodot, arrowtail=teetee, label=" user_id "];
  trek -> waitlist [arrowhead=crowodot, arrowtail=teetee, label=" trek_id "];
  booking -> payment [arrowhead=crowodot, arrowtail=teetee, label=" booking_id "];
  user -> review [arrowhead=crowodot, arrowtail=teetee, label=" user_id "];
  trek -> review [arrowhead=crowodot, arrowtail=teetee, label=" trek_id "];
  booking -> review [arrowhead=teeodot, arrowtail=teetee, label=" booking_id "];

  {rank=same; staff_profile; trek; roles_users;}
  {rank=same; booking; role; waitlist; notification;}
  {rank=same; payment; review; checklist_item;}
}

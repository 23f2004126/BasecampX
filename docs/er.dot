digraph TMA {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.6, newrank=true, bgcolor="white", pad=0.4,
         label=<<B>Trekking Management Application — ER Diagram</B><BR/><FONT POINT-SIZE="10">PK = primary key · FK = foreign key · UQ = unique · crow's-foot notation</FONT>>,
         labelloc=t, fontname="Helvetica", fontsize=18];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#555555", dir=both];

  user [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1d4ed8">
   <TR><TD BGCOLOR="#1d4ed8" COLSPAN="3"><FONT COLOR="white"><B>user</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT" PORT="id"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">VARCHAR (hashed)</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">fs_uniquifier</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">contact_number</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">is_blacklisted</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  role [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#7c3aed">
   <TR><TD BGCOLOR="#7c3aed" COLSPAN="3"><FONT COLOR="white"><B>role</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">admin / staff / user</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
  </TABLE>>];

  roles_users [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#7c3aed">
   <TR><TD BGCOLOR="#ede9fe" COLSPAN="3"><B>roles_users</B> <FONT POINT-SIZE="9">(association)</FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">→ user.id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">→ role.id</TD></TR>
  </TABLE>>];

  staff_profile [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0f766e">
   <TR><TD BGCOLOR="#0f766e" COLSPAN="3"><FONT COLOR="white"><B>staff_profile</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK, UQ</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">→ user.id</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">experience_years</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">specialization</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  trek [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b45309">
   <TR><TD BGCOLOR="#b45309" COLSPAN="3"><FONT COLOR="white"><B>trek</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">difficulty</TD><TD ALIGN="LEFT">Easy / Moderate / Hard</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">duration_days</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">total_slots</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">available_slots</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">Pending / Approved / Open /<BR ALIGN="LEFT"/>Closed / Ongoing / Completed</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">end_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">instructions</TD><TD ALIGN="LEFT">TEXT</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">image_url</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">staff_id</TD><TD ALIGN="LEFT">→ user.id (nullable)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  booking [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#be123c">
   <TR><TD BGCOLOR="#be123c" COLSPAN="3"><FONT COLOR="white"><B>booking</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">→ user.id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">trek_id</TD><TD ALIGN="LEFT">→ trek.id</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">booking_date</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">Booked / Cancelled / Completed</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">payment_status</TD><TD ALIGN="LEFT">Pending / Paid / Refunded</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">cancelled_at</TD><TD ALIGN="LEFT">DATETIME (nullable)</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">certificate_no</TD><TD ALIGN="LEFT">VARCHAR (nullable)</TD></TR>
  </TABLE>>];

  payment [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#047857">
   <TR><TD BGCOLOR="#047857" COLSPAN="3"><FONT COLOR="white"><B>payment</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">booking_id</TD><TD ALIGN="LEFT">→ booking.id</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">method</TD><TD ALIGN="LEFT">UPI / Card / NetBanking</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">Success / Failed / Refunded</TD></TR>
   <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">transaction_ref</TD><TD ALIGN="LEFT">VARCHAR (TMA-XXXXXXXX)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  review [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#a16207">
   <TR><TD BGCOLOR="#a16207" COLSPAN="3"><FONT COLOR="white"><B>review</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">→ user.id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">trek_id</TD><TD ALIGN="LEFT">→ trek.id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK, UQ</B></TD><TD ALIGN="LEFT">booking_id</TD><TD ALIGN="LEFT">→ booking.id (one review)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT">INTEGER 1–5</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">is_hidden</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  waitlist [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#4338ca">
   <TR><TD BGCOLOR="#4338ca" COLSPAN="3"><FONT COLOR="white"><B>waitlist</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">→ user.id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">trek_id</TD><TD ALIGN="LEFT">→ trek.id</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT">INTEGER (1 = next)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">Waiting / Promoted / Left</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  notification [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0369a1">
   <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>notification</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">→ user.id</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">booking / payment / waitlist /<BR ALIGN="LEFT"/>trek / system</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">link</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">is_read</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
  </TABLE>>];

  checklist_item [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#57534e">
   <TR><TD BGCOLOR="#57534e" COLSPAN="3"><FONT COLOR="white"><B>checklist_item</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">difficulty</TD><TD ALIGN="LEFT">Easy / Moderate / Hard (nullable)</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">trek_id</TD><TD ALIGN="LEFT">→ trek.id (nullable)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">item</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT">Documents / Clothing /<BR ALIGN="LEFT"/>Gear / Health</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">is_essential</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
  </TABLE>>];

  // relationships (crow's foot): tail = parent side, head = child side
  user -> roles_users [arrowtail=tee, arrowhead=crow, label="has"];
  role -> roles_users [arrowtail=tee, arrowhead=crow, label="assigned to"];
  user -> staff_profile [arrowtail=tee, arrowhead=teeodot, label="1 : 0..1  (staff only)"];
  user -> trek [arrowtail=teeodot, arrowhead=crowodot, label="staff manages  1 : 0..N"];
  user -> booking [arrowtail=tee, arrowhead=crowodot, label="trekker books  1 : 0..N"];
  trek -> booking [arrowtail=tee, arrowhead=crowodot, label="has  1 : 0..N"];
  booking -> payment [arrowtail=tee, arrowhead=crowodot, label="paid by  1 : 0..N"];
  booking -> review [arrowtail=tee, arrowhead=teeodot, label="reviewed in  1 : 0..1"];
  user -> review [arrowtail=tee, arrowhead=crowodot, label="writes  1 : 0..N"];
  trek -> review [arrowtail=tee, arrowhead=crowodot, label="rated by  1 : 0..N"];
  user -> waitlist [arrowtail=tee, arrowhead=crowodot, label="waits  1 : 0..N"];
  trek -> waitlist [arrowtail=tee, arrowhead=crowodot, label="queue  1 : 0..N"];
  user -> notification [arrowtail=tee, arrowhead=crowodot, label="receives  1 : 0..N"];
  trek -> checklist_item [arrowtail=teeodot, arrowhead=crowodot, label="extra items  0..1 : 0..N"];

  {rank=same; staff_profile; trek; roles_users;}
  {rank=same; booking; role; waitlist; notification;}
  {rank=same; payment; review; checklist_item;}
}
